andika("--- Jaribio Class Methods na Static Methods ---")

ainisha hisabati_yangu:
    class_val = 10 # Class variable

    fafanua __anza__(nafsi, instance_val):
        nafsi.instance_val = instance_val
        andika("hisabati_yangu.__anza__ called, nafsi.instance_val =", nafsi.instance_val)

    fafanua regular_method(nafsi, x):
        andika("hisabati_yangu.regular_method called, nafsi.instance_val =", nafsi.instance_val, "x =", x)
        rudisha nafsi.instance_val + x + hisabati_yangu.class_val

    fafanua cm_impl(cls, y): # cls will be hisabati_yangu ainisha kitu
        andika("hisabati_yangu.cm_impl called, cls.class_val =", cls.class_val, "y =", y)
        # Cannot access nafsi.instance_val here
        rudisha cls.class_val + y

    actual_classmethod = mbinu_aina(cm_impl)

    fafanua sm_impl(z): # No nafsi au cls
        andika("hisabati_yangu.sm_impl called, z =", z)
        # Cannot access nafsi.instance_val au cls.class_val directly
        rudisha hisabati_yangu.class_val + z # Can access class_val via ainisha jina

    actual_staticmethod = mbinu_tuli(sm_impl)

andika("hisabati_yangu.class_val =", hisabati_yangu.class_val)

# Test mbinu_aina
andika("Calling hisabati_yangu.actual_classmethod(5):")
res_cm_class = hisabati_yangu.actual_classmethod(5)  # Should pita hisabati_yangu ainisha kama cls
andika("Tokeo:", res_cm_class) # Expected: 10 + 5 = 15

# Test mbinu_tuli
andika("Calling hisabati_yangu.actual_staticmethod(7):")
res_sm_class = hisabati_yangu.actual_staticmethod(7) # No implicit first arg
andika("Tokeo:", res_sm_class) # Expected: 10 + 7 = 17

andika("Creating instance m = hisabati_yangu(20)")
m = hisabati_yangu(20)
andika("m.instance_val =", m.instance_val)
andika("m.class_val (via instance) =", m.class_val) # Python allows this, accesses class_val

# Test regular mbinu on instance
andika("Calling m.regular_method(3):")
res_reg = m.regular_method(3)
andika("Tokeo:", res_reg) # Expected: 20 + 3 + 10 = 33

# Test mbinu_aina on instance
andika("Calling m.actual_classmethod(6):")
res_cm_instance = m.actual_classmethod(6) # Should pita m's ainisha (hisabati_yangu) kama cls
andika("Tokeo:", res_cm_instance) # Expected: 10 + 6 = 16

# Test mbinu_tuli on instance
andika("Calling m.actual_staticmethod(8):")
res_sm_instance = m.actual_staticmethod(8) # No implicit first arg
andika("Tokeo:", res_sm_instance) # Expected: 10 + 8 = 18


andika("\n--- Test pamoja *args na **kwargs pamoja static/ainisha methods ---")

