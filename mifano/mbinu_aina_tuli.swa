ainisha MyMath2:
    thamani = 10 # Class variable

    fafanua regular_method(nafsi, x):
        rudisha nafsi.thamani + x

    fafanua cm(cls, y): # cls will be hisabati_yangu ainisha kitu
        rudisha cls.thamani + y

    classmethod_impl = mbinu_aina(cm) # cm becomes a mbinu_aina named classmethod_impl

    fafanua sm(z): # No nafsi au cls
        rudisha z * 2

    staticmethod_impl = mbinu_tuli(sm) # sm becomes a mbinu_tuli

# Accessing via ainisha
andika(MyMath2.thamani)                 # Output: 10 (Class variable)
andika(MyMath2.staticmethod_impl(5)) # Output: 10 (Calls sm(5))
andika(MyMath2.classmethod_impl(3)) # Output: 13 (Calls cm(hisabati_yangu, 3))
# andika(hisabati_yangu.regular_method(Tupu, 1)) # Kosa au special handling kwa unbound instance methods

# Accessing via instance
m = MyMath2()
m.thamani = 20 # Instance variable shadows ainisha variable kwa this instance
andika(m.thamani)                     # Output: 20 (Instance variable)
andika(m.regular_method(5))       # Output: 25 (nafsi.thamani ni 20)
andika(m.staticmethod_impl(5))    # Output: 10 (Calls sm(5), no nafsi)
andika(m.classmethod_impl(3))     # Output: 13 (Calls cm(hisabati_yangu, 3), cls ni hisabati_yangu, sio m's ainisha ikiwa m was subclass)


ainisha MyClass:
    fafanua __anza__(nafsi, jina):
        nafsi.jina = jina

    @mbinu_aina
    fafanua my_cm(cls, arg):
        andika(umbiza_maneno("Called kutoka ainisha: {cls.jina} pamoja arg: {arg}"))

MyClass.my_cm(123)