sambamba fafanua programu_kuu():
    andika("--- Jaribio Lambda Functions ---")

    # Simple lambda
    jumlisha = lambda x, y: x + y
    tokeo = jumlisha(5, 3)
    andika(umbiza_maneno("jumlisha(5, 3) = {tokeo}")) # Expected: 8

    # Using lambda pamoja map/filter (ikiwa they were implemented)
    # For now, let's just show it can be passed kama an argument
    fafanua operate(func, a, b):
        rudisha func(a, b)

    mult_result = operate(lambda a, b: a * b, 6, 7)
    andika(umbiza_maneno("operate(lambda, 6, 7) = {mult_result}")) # Expected: 42

    # Lambda pamoja a default argument
    power = lambda base, exp=2: base ** exp
    andika(umbiza_maneno("power(3) = {power(3)}")) # Expected: 9
    andika(umbiza_maneno("power(3, 3) = {power(3, 3)}")) # Expected: 27

    # Immediately invoked lambda
    imm_result = (lambda x: x + 1)(10)
    andika(umbiza_maneno("(lambda x: x + 1)(10) = {imm_result}")) # Expected: 11