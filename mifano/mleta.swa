fafanua func(a, b=2, *args, **kwargs):
    andika(a, b, args, kwargs)

func(1)           # a=1, b=2, args=[], kwargs={}
func(1, 3, 4, 5, x=6)  # a=1, b=3, args=[4, 5], kwargs={}


ainisha BaseHTTPMiddleware:
    fafanua __anza__(nafsi, programu):
        nafsi.programu = programu

    fafanua dispatch(nafsi, ombi, call_next):
        # Base implementation, maybe some logging
        andika("BaseHTTPMiddleware dispatch called",nafsi.programu)
        jibu = 'call_next(ombi)'
        rudisha jibu

ainisha LoggingMiddleware(BaseHTTPMiddleware):
    fafanua __anza__(nafsi, programu):
        bora(LoggingMiddleware, nafsi).__anza__(programu) # Uses bora(Type, nafsi)
        andika("LoggingMiddleware initialized")

    fafanua dispatch(nafsi, ombi, call_next):
        andika(ombi)
        hujambo = "hujambo"
        andika(f("Ombi (Logging): {ombi['url']} {hujambo}"))
        # jibu = bora().dispatch(ombi, call_next) # Needs zero-arg bora()
        # For now, pamoja two-arg bora:
        jibu = bora(LoggingMiddleware, nafsi).dispatch(ombi, call_next)
        andika(f("Jibu (Logging): ..."))
        rudisha jibu

programu = {"ombi":"hi","jibu":"bye","url":"http://google.com"}
c = LoggingMiddleware(programu)
andika(c.dispatch(programu, Tupu))


