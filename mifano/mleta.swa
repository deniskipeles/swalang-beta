sambamba fafanua leta_data(url):
    # sambamba operation
    http.pata(url)
    data = subiri http.pata(url)
    rudisha data

sambamba fafanua programu_kuu():
    data1 = subiri leta_data("jsonplaceholder.typicode.com/todos/1")  # These can endesha concurrently
    data2 = subiri leta_data("jsonplaceholder.typicode.com/todos/2")
    rudisha [data1, data2]




fafanua test():
    obj = {'a': 1, 'b': 2 }
    y = [1,2,3]

    andika('outer fxn',obj,y)
    fafanua inner():
        andika('inner fxn')
    inner()
test()
