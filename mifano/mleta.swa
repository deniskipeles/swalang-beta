# This ni importer.py
leta swalang_importlib # Assuming this ni how we access the new module

andika("Importer: Trying to pakia hisabati_yangu.py dynamically...")

# Construct the njia relative to importer.py
# In a real framework, njia resolution would be more robust.
# For this example, let's assume hisabati_yangu.py ni katika the same directory.
math_module_path = "./hisabati_yangu.py"
# Or, ikiwa your SetCurrentScriptDir works well, just "hisabati_yangu.py" might be enough
# ikiwa importer.py na hisabati_yangu.py are katika the same directory kutoka where you endesha.
# To be safe, let's assume SetCurrentScriptDir correctly sets context to examples/

jaribu:
    # Use the dynamic loading function
    math = swalang_importlib.load_module_from_path(math_module_path)
    andika(math)
    x = {
        "a":1,
        "b":2
    }

    ikiwa math: # Check ikiwa loading was successful (sio an Kosa kitu)
        andika("Importer: hisabati_yangu module loaded successfully.")
        andika("Importer: Type of math:", aina(math)) # Should be <ainisha 'module'>

        # Access attributes kutoka the dynamically loaded module
        andika("Importer: PAI kutoka math:", math.PAI)

        sum_result = math.jumlisha(10, 5)
        andika("Importer: math.jumlisha(10, 5) =", sum_result)

        diff_result = math.toa(10, 3)
        andika("Importer: math.toa(10, 3) =", diff_result)
    ingine:
        andika("Importer: Failed to pakia hisabati_yangu module (math ni Tupu au an kosa occurred before assignment).")

isipokuwa Isipokuwa kama e: # Generic Pylearn isipokuwa
    andika("Importer: An kosa occurred during leta au usage:", 'e')

andika("Importer: Script finished.")

