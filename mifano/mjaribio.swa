# kosa.py

fafanua kosa(value):
    ikiwa value == 1:
        ibua Isipokuwa('One')
    ikiwaingine value == 2:
        ibua Isipokuwa('Two')
    ikiwaingine value == 3:
        ibua Isipokuwa('Three')
    ikiwaingine value == 4:
        ibua Isipokuwa('Four')
    ingine:
        andika('no kosa here')
jaribu:
    e = kosa(1)
isipokuwa Isipokuwa kama e:
    andika(e)
