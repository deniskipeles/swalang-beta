# examples/tuple_test.py
single_line_tuple = (1, 2, 3)
andika(single_line_tuple)
andika(aina(single_line_tuple))

multiline_tuple = (
    1,
    2,
    3,
    4,
    5,
    (
        6,
        7,
        8
    )
)

andika(multiline_tuple)
andika(aina(multiline_tuple))


x=(1,2,3)
y=(1,2,3)
andika(x,y)
andika(y.hesabu(2))

x = multiline_tuple
kwa i katika x:
    andika(i)