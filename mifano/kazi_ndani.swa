# function call itself
fafanua factorial(n):
    # Base case (simama condition)
    ikiwa n == 0:
        rudisha 1
    # Recursive step (function calls itself)
    ingine:
        rudisha n * factorial(n - 1)


andika(factorial(30))  # Output: 265252859812191058636308480000000

