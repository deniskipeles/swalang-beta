leta sdl2
leta nuklear

andika("🧪 Initializing SDL2 & Nuklear...")
# Initialize video na events
sdl2.anza(sdl2.SDL_INIT_VIDEO | sdl2.SDL_INIT_EVENTS)

win = sdl2.Dirisha("Nuklear UI via Swalang", 800, 600)
ren = sdl2.Wasilishaji(win)
ev = sdl2.Tokeo()

# Initialize Nuklear Context na Input helper
ctx = nuklear.Context()
ctx.anza() # Must call anza to seti up internal memory
nk_input = nuklear.NuklearSDLInput(ctx)

andika("🚀 UI Loop started. Funga the dirisha to exit.")

clicks = 0
inaendesha = Kweli

wakati inaendesha:
    # --- Input Gathering ---
    nk_input.begin()
    wakati ev.uliza():
        ikiwa ev.aina == sdl2.SDL_QUIT:
            inaendesha = Uongo
        # Feed the SDL tokeo to the Nuklear ingiza mshughulikiaji
        nk_input.feed(ev)
    nk_input.end()

    # --- UI Building ---
    # Use NK_ prefixed constants kama defined katika the library
    window_flags = nuklear.NK_WINDOW_BORDER | nuklear.NK_WINDOW_MOVABLE | nuklear.NK_WINDOW_TITLE

    ikiwa ctx.begin("Demo Dirisha", 50, 50, 250, 200, window_flags):

        ctx.layout_row_dynamic(30, 1)
        ctx.lebo(umbiza_maneno("Clicks: {clicks}"), nuklear.NK_TEXT_CENTERED)

        ctx.layout_row_dynamic(30, 1)
        ikiwa ctx.button_label("Bonyeza Me!"):
            clicks = clicks + 1
            andika(umbiza_maneno("👉 Kitufe ibonyezwe! Total: {clicks}"))

    ctx.end()

    # --- Rendering ---
    ren.set_draw_color(30, 30, 30, 255)
    ren.futa()

    # Note: Kweli rendering requires a backend wasilishaji.
    # For now, we futa the context to prepare kwa the next frame.
    ctx.futa()

    ren.onyesha()
    sdl2.delay(16)

andika("Sweep 🧹 Cleaning up...")
ctx.free()
ev.free()
ren.destroy()
win.destroy()
sdl2.toka()
andika("✅ SDL2 exited gracefully.")